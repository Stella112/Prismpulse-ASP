NODE_ENV=development
PORT=4021
PUBLIC_BASE_URL=https://api.getprismpulse.xyz
DATABASE_URL=postgresql://prismpulse:change-me@postgres:5432/prismpulse
EVIDENCE_SEAL_DIR=./data/seals

# X Layer mainnet. Test and staging must override this with eip155:1952.
XLAYER_NETWORK=eip155:196
XLAYER_RPC_URL=https://rpc.xlayer.tech
RECEIPT_ANCHOR_ADDRESS=
XLAYER_EXPLORER_URL=https://www.oklink.com/x-layer
# Anchor jobs persist beside Evidence Seals. Keep issuer and deployer keys out of Git.
ANCHOR_JOB_DIR=./data/seals/anchors
ANCHOR_ISSUER_PRIVATE_KEY=
ANCHOR_WORKER_INTERVAL_MS=5000
REGISTRY_DEPLOYER_PRIVATE_KEY=
REGISTRY_DEPLOYER_ADDRESS=
REGISTRY_OWNER_ADDRESS=
ANCHOR_ISSUER_ADDRESS=
COVERAGE_POOL_ADDRESS=

# Browser issuance is a deliberately separate, rate-limited product surface.
CONSOLE_ISSUANCE_ENABLED=false

# OKX seller credentials. Never expose these to browser code.
PAYMENTS_ENABLED=false
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BASE_URL=https://web3.okx.com
PAY_TO_ADDRESS=
SENTINEL_PRICE_USD=$0.01

# Local Llama is a load-bearing defensive reasoner. Unavailability fails closed.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=20000

# Passive Hive capture authentication and persistent rule set.
HIVE_STORE_FILE=./data/seals/hive-signatures.json
HIVE_CAPTURE_TOKEN=

# Bounded autonomy. A non-zero transfer without a USD valuation fails closed.
SENTINEL_HIGH_VALUE_USD=100
PER_TRANSACTION_CAP_USD=100
DAILY_CAP_USD=500
ROLLING_DAILY_SPEND_USD=0
GLOBAL_KILL_SWITCH=false
